# Freshbunch Backend Environment Variables
PORT=5000
JWT_SECRET=freshbunch_super_secret_jwt_key_2026

# Supabase Database Connection (Get from Supabase Dashboard -> Project Settings -> Database -> URI)
# Example: postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Credentials (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
